      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi Kilas Works\"><a href=\"#home\" aria-current=\"page\">Home</a><a href=\"#ai\">Kilas AI</a><a href=\"#connections\">Connections</a></nav>",
