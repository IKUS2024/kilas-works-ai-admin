                  "type": "string",
                  "maxLength": 24,
                  "pattern": "^(?!0+(?:\\.0+)?$)\\d{1,9}(?:\\.\\d{1,8})?$",
                  "description": "Positive decimal <=100000000; numeric bound checked by server."
                },
                "ask": {
                  "type": "string",
                  "maxLength": 24,
                  "pattern": "^(?!0+(?:\\.0+)?$)\\d{1,9}(?:\\.\\d{1,8})?$",
