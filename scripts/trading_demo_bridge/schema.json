                    "offset_seconds": {
                      "type": "string",
                      "maxLength": 24,
                      "pattern": "^-?\\d{1,5}(?:\\.\\d{1,8})?$",
                      "description": "Absolute value <=60"
                    },
                    "uncertainty_ms": {
                      "type": "string",
                      "maxLength": 24,
                      "pattern": "^-?\\d{1,5}(?:\\.\\d{1,8})?$",
