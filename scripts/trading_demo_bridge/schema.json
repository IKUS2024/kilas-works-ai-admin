      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "symbol": {
              "enum": [
                "GOLD",
                "BTCUSD"
              ]
            },
            "timeframe": {
              "const": "M1"
            },
