+<article class="invoice-document statement-document" aria-label="Statement customer">
+<header class="invoice-header"><div><h2>{{ doc.issuer }}</h2><p>Ringkasan piutang customer</p></div><div class="invoice-reference"><h1>STATEMENT</h1><p>Per {{ doc.as_of }}</p></div></header>
+<section class="invoice-parties"><div><p class="invoice-muted">Kepada</p><h2>{{ doc.customer.name }}</h2>{% if doc.customer.email %}<p>{{ doc.customer.email }}</p>{% endif %}{% if doc.customer.phone %}<p>{{ doc.customer.phone }}</p>{% endif %}</div></section>
