+<div class="fin-grid">{% for key,label in [('total_outstanding_minor','Total piutang'),('total_overdue_minor','Lewat jatuh tempo'),('open_invoice_count','Invoice terbuka'),('overdue_invoice_count','Invoice terlambat')] %}<div class="card"><h2>{{ label }}</h2><strong class="fin-total">{{ data.aging[key]|finance_idr if key.endswith('_minor') else data.aging[key] }}</strong></div>{% endfor %}</div>
+<h2>Umur piutang</h2><div class="fin-grid">{% for b in data.aging.buckets %}<div class="card"><strong>{{ b.label }}</strong><p>{{ b.amount_minor|finance_idr }} · {{ b.invoice_count }} invoice</p></div>{% endfor %}</div>
+<form method="get" class="card"><div class="fin-grid"><div><label for="view">Tampilkan</label><select id="view" name="view">{% for value,label in [('all','Semua terbuka'),('overdue','Lewat jatuh tempo'),('soon','Jatuh tempo 0–7 hari lagi')] %}<option value="{{ value }}" {{ 'selected' if view==value }}>{{ label }}</option>{% endfor %}</select></div><div><label for="sort">Urutkan</label><select id="sort" name="sort">{% for value,label in [('overdue','Paling lama terlambat'),('balance','Sisa tagihan terbesar'),('due','Tanggal jatuh tempo'),('customer','Nama customer')] %}<option value="{{ value }}" {{ 'selected' if sort==value }}>{{ label }}</option>{% endfor %}</select></div></div><button class="btn">Terapkan</button></form>
+<h2>Antrean penagihan · {{ queue.count }} invoice</h2>
+{% for i in queue.rows %}<article class="card"><h3>{{ i.customer_name }} · {{ i.invoice_number }}</h3><p>{{ labels[i.status] }} · Jatuh tempo {{ i.due_date }}{% if i.overdue %} · <strong>{{ i.days_late }} hari terlambat</strong>{% else %} · Belum terlambat{% endif %}</p><div class="fin-grid"><p>Total<br><strong>{{ i.total_minor|finance_idr }}</strong></p><p>Dibayar<br><strong>{{ i.paid_minor|finance_idr }}</strong></p><p>Sisa tagihan<br><strong>{{ i.outstanding_minor|finance_idr }}</strong></p></div>
+<a class="btn secondary" href="{{ url_for('finance.invoice_detail',business_id=business.id,invoice_id=i.id) }}">Invoice / Catat Pembayaran</a>
+<a class="btn secondary" href="{{ url_for('finance.customer_statement',business_id=business.id,customer_id=i.customer_id) }}">Statement Customer</a>
+{% if i.overdue %}<a class="btn secondary" href="{{ url_for('finance.collection_reminder',business_id=business.id,invoice_id=i.id) }}">Siapkan Reminder</a>{% endif %}</article>{% else %}<div class="card">Tidak ada invoice untuk pilihan ini.</div>{% endfor %}
+<nav aria-label="Halaman penagihan"><p>Halaman {{ queue.page }} / {{ queue.pages }}</p>{% if queue.page>1 %}<a class="btn secondary" href="{{ url_for('finance.collections',business_id=business.id,sort=sort,view=view,page=queue.page-1) }}">Sebelumnya</a>{% endif %}{% if queue.page<queue.pages %}<a class="btn secondary" href="{{ url_for('finance.collections',business_id=business.id,sort=sort,view=view,page=queue.page+1) }}">Berikutnya</a>{% endif %}</nav>
+</div>{% endblock %}
